# ==============================================================================
# RADAR VIBZ — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# O sistema funciona 100% em modo de demonstração/simulação mesmo com todas as
# variáveis externas vazias. Preencha apenas as integrações que desejar ativar.

# --- SERVIDOR HTTP (NODE.JS / EXPRESS) ---
PORT=3000
NODE_ENV=development

# --- GOOGLE GEMINI AI ---
# Obtido no Google AI Studio (https://aistudio.google.com/app/apikey).
# Utilizado para análise semântica das legendas, extração de eventos e oportunidades.
# Se não configurado, o sistema utiliza o motor heurístico local (fallback automático).
GEMINI_API_KEY=""

# --- META GRAPH API (INSTAGRAM BUSINESS DISCOVERY) ---
# Obtidos no Meta for Developers (https://developers.facebook.com).
# - META_ACCESS_TOKEN: Token de acesso do usuário de sistema ou token de longa duração da página.
# - META_PAGE_ID: ID da Página do Facebook vinculada à conta profissional do Instagram.
# Se não configurados, o sistema opera via modo demonstrativo com publicações realistas simuladas.
META_ACCESS_TOKEN=""
META_PAGE_ID=""

# --- TELEGRAM BOT API ---
# Criado via @BotFather no Telegram.
# - TELEGRAM_BOT_TOKEN: Token HTTP retornado pelo @BotFather ao criar o bot.
# - TELEGRAM_CHAT_ID: ID do chat pessoal, grupo ou canal de destino dos alertas (ex: -100xxxxxxxxxx).
# Se não configurados, o disparo opera em modo simulado e é registrado nos logs do sistema.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- APLICAÇÃO ---
# URL base da aplicação para links de retorno e APIs.
APP_URL="http://localhost:3000"
